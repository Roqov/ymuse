<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ymuse</AssemblyName>
    <RootNamespace>Ymuse</RootNamespace>
    <Product>Ymuse</Product>
    <Version>0.2.2</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Канал обновлений: работает и когда сборка распакована вне репозитория. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/Roqov/ymuse" />
  </ItemGroup>

</Project>
